# RPC endpoints (see docs/architecture.md for chain details)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your-project-id
CREDITCOIN_TESTNET_RPC_URL=https://rpc.cc3-testnet.creditcoin.network

# Deploy wallet private key (hex, no 0x prefix or with — cast accepts both).
# MUST be a dedicated testnet-only wallet, never a personal/mainnet key.
PRIVATE_KEY=

# ClaimVault constructor parameters (see script/DeployClaimVault.s.sol)
# SOURCE_CONTRACT_ADDRESS is DeliveryTrackerMock's deployed address on Sepolia
# (see scripts/deployments.json) -- only DeliveryFailed events emitted by this
# exact contract are honored.
SOURCE_CONTRACT_ADDRESS=
WORKER_ADDRESS=
PAYOUT_CAP_WEI=1000000000000000000

# Optional: contract verification on Sepolia
ETHERSCAN_API_KEY=
