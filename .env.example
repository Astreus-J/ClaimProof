# Single env file for `docker compose up --build` — copy to `.env` and
# fill in real values. Mirrors backend/.env.example + frontend/.env.example;
# running services outside Docker still uses those per-service files.

# --- Backend (cmd/api + cmd/worker) ---

# SEPOLIA_WSS_URL must be a WebSocket endpoint (used by cmd/worker's live
# event subscription) — not every RPC provider offers one. SEPOLIA_RPC_URL
# is plain HTTP, used by cmd/api to send transactions. Get a project ID
# from e.g. Infura or Alchemy.
SEPOLIA_WSS_URL=wss://sepolia.infura.io/ws/v3/your-project-id
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your-project-id
CREDITCOIN_TESTNET_RPC_URL=https://rpc.cc3-testnet.creditcoin.network

# Deployed contract addresses — copy from scripts/deployments.json
# (sepolia.DeliveryTrackerMock / creditcoinTestnet.ClaimVault).
DELIVERY_TRACKER_MOCK_ADDRESS=
CLAIM_VAULT_ADDRESS=

ATTESTCOIN_PROVER_URL=https://prover.cc3-testnet.creditcoin.network

# Dedicated testnet-only wallet (hex private key). MUST be a wallet you
# control that holds Sepolia ETH and Creditcoin CC3 testnet CTC — never a
# personal/mainnet key. Never commit a real value here.
WORKER_PRIVATE_KEY=

# AI claims agent LLM provider — one of: gemini, openai, anthropic.
LLM_PROVIDER=gemini
LLM_API_KEY=
# Optional: overrides the chosen provider's default model.
LLM_MODEL=

# Maximum payout the claims agent may suggest, enforced again on-chain by
# ClaimVault's payoutCap.
POLICY_CAP_WEI=1000000000000000000

# cmd/api — both optional, sane defaults shown.
API_LISTEN_ADDR=:8080
API_CORS_ORIGIN=http://localhost:3000

# cmd/worker (optional) — where cmd/api is reachable, so the worker can
# report the AI's payout reasoning for the dashboard. Under
# `docker compose up`, docker-compose.yml overrides this automatically to
# the api service's internal DNS name — no need to set it here for Docker.
API_BASE_URL=http://localhost:8080

# --- Frontend (baked into the client bundle at image build time) ---

NEXT_PUBLIC_DELIVERY_TRACKER_MOCK_ADDRESS=
NEXT_PUBLIC_CLAIM_VAULT_ADDRESS=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
