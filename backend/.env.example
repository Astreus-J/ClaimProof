# RPC endpoints (see docs/architecture.md for chain details)
SEPOLIA_WSS_URL=wss://sepolia.infura.io/ws/v3/your-project-id
CREDITCOIN_TESTNET_RPC_URL=https://rpc.cc3-testnet.creditcoin.network

# Deployed contract addresses (filled in after Sprint 1's deploy; see
# scripts/deployments.json, the single source of truth for addresses)
DELIVERY_TRACKER_MOCK_ADDRESS=
CLAIM_VAULT_ADDRESS=

# Attestcoin Prover REST API (no official Go SDK — see internal/proofbuilder)
ATTESTCOIN_PROVER_URL=https://prover.cc3-testnet.creditcoin.network

# Worker wallet private key (hex). MUST be a dedicated testnet-only wallet,
# never a personal/mainnet key. Never commit a real value here.
WORKER_PRIVATE_KEY=

# AI claims agent LLM provider credentials
LLM_API_KEY=

# Maximum payout the claims agent may suggest, enforced again on-chain by
# ClaimVault's payoutCap (see contracts/.env.example PAYOUT_CAP_WEI)
POLICY_CAP_WEI=1000000000000000000
