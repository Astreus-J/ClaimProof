# Deployed contract addresses (see scripts/deployments.json)
NEXT_PUBLIC_DELIVERY_TRACKER_MOCK_ADDRESS=
NEXT_PUBLIC_CLAIM_VAULT_ADDRESS=

# ClaimProof storefront API (backend/cmd/api)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Public, rate-limited RPC endpoints for read-only chain access from the
# browser. Never put a private/paid RPC key here — NEXT_PUBLIC_ variables
# are bundled into client-side JavaScript and visible to every visitor.
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network

# Optional: a Reown Cloud (WalletConnect) project ID, for the WalletConnect
# QR-code connector. Without it, only the injected connector (MetaMask,
# etc.) is available -- the safer default for a live demo.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
